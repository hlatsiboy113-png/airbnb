# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/airstay

# Use a long, random value in production
JWT_SECRET=replace-with-a-long-random-production-secret

# Comma-separated allowed browser origins (e.g. both Vercel domains)
# In production without this, all origins are allowed.
CORS_ORIGIN=
